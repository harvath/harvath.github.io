---
import '../styles/global.css';
import { formatIsoJst } from '../lib/posts';
import { GITHUB_URL, SITE_NAME } from '../lib/site';

interface Props {
  /** ページ名。省略するとトップ扱い（`<title>` はサイト名だけ）。 */
  title?: string;
  /** 無いときは description と og:description を出さない。 */
  description?: string;
  type?: 'website' | 'article';
  /** ページの正規 URL（site からの相対で可）。渡したときだけ canonical と og:url を出す。 */
  canonical?: URL | string;
  /** 記事の公開日。`article:published_time` に出す。 */
  publishedTime?: Date;
  /** 検索エンジンに載せないページ（404 など）。 */
  noindex?: boolean;
}

const {
  title,
  description,
  type = 'website',
  canonical,
  publishedTime,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const ogTitle = title ?? SITE_NAME;
const canonicalUrl = canonical && new URL(canonical, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_NAME}
      href="/rss.xml"
    />
    <meta property="og:title" content={ogTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={type} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    {type === 'article' && publishedTime && (
      <meta
        property="article:published_time"
        content={formatIsoJst(publishedTime)}
      />
    )}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">
        {SITE_NAME}
      </a>
      <nav>
        <a href="/about/">about</a>
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        <a href="/rss.xml">RSS</a>
        {' · '}
        <a href={GITHUB_URL} target="_blank" rel="noopener">
          GitHub
        </a>
      </p>
      <p>© {SITE_NAME}</p>
    </footer>
  </body>
</html>
