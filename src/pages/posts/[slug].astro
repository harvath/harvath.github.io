---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const date = formatDate(post.data.date);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <time datetime={date}>{date}</time>
    <Content />
  </article>
  <nav>
    {older && <a href={older.url}>前の記事: {older.data.title}</a>}
    {newer && <a href={newer.url}>次の記事: {newer.data.title}</a>}
    <a href="/">トップへ</a>
  </nav>
</Base>
