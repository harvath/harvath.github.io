---
import { posix } from 'node:path';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base, { type OgImage } from '../../layouts/Base.astro';
import { firstImage } from '../../lib/og';
import { formatDate, getPosts, type Post } from '../../lib/posts';

/** 記事フォルダに置かれた画像。key は `/src/content/blog/<id>/<file>`。 */
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/content/blog/*/*.{png,jpg,jpeg,webp,gif,avif}',
);

const OG_FORMATS = new Set(['png', 'jpg', 'jpeg', 'webp', 'gif', 'avif']);

/**
 * 本文の最初の画像を OGP 画像にする。無ければ `undefined`（サイト共通の og.png になる）。
 * 相対パスは記事フォルダから解決し、Astro の画像処理を通した URL（幅 1200 まで）を使う。
 */
async function ogImageFor(post: Post): Promise<OgImage | undefined> {
  const ref = firstImage(post.body ?? '');
  if (!ref) return undefined;
  if (/^https?:\/\//.test(ref)) return { url: ref };

  const dir = post.filePath
    ? posix.dirname(post.filePath)
    : `src/content/blog/${post.id}`;
  const key = '/' + posix.normalize(posix.join(dir, ref));
  const load = localImages[key];
  if (!load) return undefined;

  const { default: meta } = await load();
  const format = OG_FORMATS.has(meta.format) ? meta.format : 'png';
  const img = await getImage({
    src: meta,
    width: Math.min(meta.width, 1200),
    format,
  });
  return {
    url: new URL(img.src, Astro.site).href,
    width: Number(img.attributes.width) || undefined,
    height: Number(img.attributes.height) || undefined,
  };
}

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const date = formatDate(post.data.date);
const image = await ogImageFor(post);
---

<Base
  title={post.data.title}
  description={post.data.description}
  type="article"
  canonical={post.url}
  publishedTime={post.data.date}
  image={image}
>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <time class="post-date" datetime={date}>
        {date}
      </time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="post-nav" aria-label="前後の記事">
    {older && <a href={older.url}>← 前の記事: {older.data.title}</a>}
    {newer && <a href={newer.url}>次の記事: {newer.data.title} →</a>}
    <a class="to-index" href="/">
      記事一覧へ
    </a>
  </nav>
</Base>
