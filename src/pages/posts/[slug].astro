---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const date = formatDate(post.data.date);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <time class="post-date" datetime={date}>
        {date}
      </time>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <nav class="post-nav" aria-label="前後の記事">
    {older && <a href={older.url}>← 前の記事: {older.data.title}</a>}
    {newer && <a href={newer.url}>次の記事: {newer.data.title} →</a>}
    <a class="to-index" href="/">
      記事一覧へ
    </a>
  </nav>
</Base>
