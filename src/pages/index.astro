---
import Base from '../layouts/Base.astro';
import { formatDate, getPosts, groupByYear } from '../lib/posts';
import { SITE_DESCRIPTION, SITE_NAME } from '../lib/site';

const years = groupByYear(await getPosts());
---

<Base description={SITE_DESCRIPTION} canonical="/">
  <h1 class="visually-hidden">{SITE_NAME}</h1>
  {years.map(([year, posts]) => (
    <section>
      <h2 class="year" id={year}>
        {year}
      </h2>
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <time datetime={formatDate(post.data.date)}>
              {formatDate(post.data.date)}
            </time>
            <a href={post.url}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
